{
  "version": "0.1.1",
  "name": "@modality-ai/copilot-loop",
  "author": "Hill <hill@kimo.com>",
  "license": "ISC",
  "peerDependencies": {
    "hono": "^4.12.25"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.11"
  },
  "devDependencies": {
    "modality-bun-kit": "^1.3.131"
  },
  "exports": {
    "types": "./dist/types/index.d.ts",
    "require": "./dist/index.mjs",
    "import": "./dist/index.mjs"
  },
  "types": "./dist/types/index.d.ts",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "bin": {
    "copilot-loop": "./dist/cli.mjs"
  },
  "scripts": {
    "start": "bun ./src/server.ts",
    "build:clean": "find ./dist -name '*.*' | xargs rm -rf",
    "build:types": "bun tsc -p ./",
    "build:cli": "bun build src/cli.ts --outfile dist/cli.mjs --target node",
    "build:src": "bun build src/index.ts --outfile dist/index.mjs --target node",
    "build": "bun run build:clean && bun run build:types && bun run build:src && bun run build:cli",
    "dev": "bun --hot ./src/server.ts",
    "test": "npm run build && bun test",
    "prepublishOnly": "npm t"
  },
  "files": ["package.json", "README.md", "dist"]
}
